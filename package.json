{
  "name": "yes-no-together",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "concurrently -k \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vite --host 127.0.0.1",
    "dev:api": "wrangler dev --config worker/wrangler.jsonc --port 8787 --ip 127.0.0.1",
    "check": "tsc --noEmit && tsc --noEmit -p worker/tsconfig.json",
    "build": "npm run check && vite build",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "deploy:api": "wrangler deploy --config worker/wrangler.jsonc",
    "push:keys": "node scripts/generate-push-keys.mjs"
  },
  "dependencies": {
    "@block65/webcrypto-web-push": "^2.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261113.1",
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "concurrently": "^9.2.1",
    "typescript": "^5.9.3",
    "vite": "^7.2.2",
    "wrangler": "^4.47.0"
  }
}
